<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.jws.musicflows.infrastructure.test.TestsMapper">

    <select
        id="findAll"
        resultType="com.jws.musicflows.infrastructure.test.TestsEntity">

        SELECT
            id,
            name,
            created_at
        FROM tests
        ORDER BY created_at DESC

    </select>

    <select
        id="findById"
        parameterType="java.lang.Long"
        resultType="com.jws.musicflows.infrastructure.test.TestsEntity">

        SELECT
            id,
            name,
            created_at
        FROM tests
        WHERE id = #{id}

    </select>

    <insert
        id="insert"
        parameterType="com.jws.musicflows.infrastructure.test.TestsEntity"
        useGeneratedKeys="true"
        keyProperty="id"
        keyColumn="id">

        INSERT INTO tests (
            name
        ) VALUES (
            #{name}
        )

    </insert>

</mapper>