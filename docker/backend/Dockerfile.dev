FROM eclipse-temurin:25-jdk

# ---------------------------------------------------------
# ホスト側のUID/GIDをDocker Composeから受け取る
# ---------------------------------------------------------
ARG USER_ID=1000
ARG GROUP_ID=1000

WORKDIR /app

# ---------------------------------------------------------
# Gradle User Home
#
# ベースイメージ側のユーザー名には依存せず、
# 専用ディレクトリを使用する。
# ---------------------------------------------------------
ENV HOME=/home/app
ENV GRADLE_USER_HOME=/home/app/.gradle

# ---------------------------------------------------------
# Gradleが使用するディレクトリを作成
# UID/GIDで所有者を指定するため、
# appというグループを新規作成する必要はない。
# ---------------------------------------------------------
RUN mkdir -p /home/app/.gradle \
    && chown -R ${USER_ID}:${GROUP_ID} /home/app

# ---------------------------------------------------------
# ユーザー名ではなくUID/GIDで実行する
# ---------------------------------------------------------
USER ${USER_ID}:${GROUP_ID}

EXPOSE 8080

CMD ["./gradlew", "bootRun", "--no-daemon"]